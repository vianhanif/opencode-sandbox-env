# Example environment file — copy to env/opencode.env and replace placeholders
# NEVER commit real secrets to this repository.

# 9router model routing (co-located 9router-api container)
ROUTER9_GATEWAY_URL=http://9router-api:20127
ROUTER9_GATEWAY_KEY=REPLACE_ME
ROUTER9_API_KEY=REPLACE_ME

# LLM provider fallback — dev-only; override on VPS with 9router-api address
# OPENCODE_PROVIDER_URL=http://host.docker.internal:20127

# GitHub CLI auth
GH_TOKEN=REPLACE_ME

# GitLab CLI auth
GITLAB_TOKEN=REPLACE_ME

# OpenCode server password (for opencode web browser access)
OPENCODE_SERVER_PASSWORD=REPLACE_ME

# Cloudflare Tunnel token
CLOUDFLARED_TOKEN=REPLACE_ME

# OpenCode domain (used by Caddy reverse proxy)
OPENCODE_DOMAIN=opencode.example.com

# AWS credentials (optional — for awscli)
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=ap-southeast-1
