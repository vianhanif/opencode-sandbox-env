# Deployment-level environment for opencode-sandbox-env
# Copy to .env and fill in real values. Never commit real secrets.

# Public domain routed through the Cloudflare tunnel -> Caddy -> opencode web
OPENCODE_DOMAIN=opencode.example.com

# Port the opencode web server listens on inside the container (bound to
# localhost only on the VPS; public ingress is via Caddy/tunnel exclusively)
OPENCODE_PORT=4096

# Cloudflare tunnel
CLOUDFLARED_TOKEN=replace-me
CLOUDFLARED_TUNNEL_ID=replace-me

# Tencent VPS access (used by the CI deploy pipeline)
TENCENT_HOST=replace-me
TENCENT_USER=replace-me
TENCENT_SSH_KEY=replace-me

# 9router gateway (co-located 9router-api on the same VPS)
ROUTER9_GATEWAY_URL=http://9router-api:20127
ROUTER9_GATEWAY_KEY=replace-me