# Runtime env for the opencode container (opencode service -> env/opencode.env)
# Copy to env/opencode.env and fill in real values. Never commit real secrets.

# Browser auth for opencode web
OPENCODE_SERVER_PASSWORD=replace-me
OPENCODE_SERVER_USERNAME=opencode

# 9router gateway (model routing) - co-located 9router-api on the VPS; dev
# fallback http://host.docker.internal:20127
ROUTER9_GATEWAY_URL=http://9router-api:20127
ROUTER9_GATEWAY_KEY=replace-me
ROUTER9_API_KEY=replace-me

# External CLI credentials (never baked into the image)
GH_TOKEN=replace-me
GITLAB_TOKEN=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-singapore

# Firstmate home (FM_HOME) - persisted via volumes
# NOTE: must match Dockerfile ENV FM_HOME=/home/opencode/.firstmate
# FM_HOME is the firstmate checkout; data dirs live under /home/opencode
FIRSTMATE_HOME=/home/opencode
FM_HOME=/home/opencode/.firstmate
